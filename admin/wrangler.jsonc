// We Love Cookies optional admin: a Worker on your own Cloudflare account. Setup: docs/ADMIN.md
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "welovecookies-admin",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Serves welovecookies.min.js (copied from dist/ by npm run admin:assets). Everything else runs the Worker.
	"assets": { "directory": "./public" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "welovecookies",
			// Replace with the id printed by: npx wrangler d1 create welovecookies
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// Per-IP limit on the public endpoints (/api/consent*, privacy form posts), per Cloudflare location.
	// namespace_id is any integer unique within your Cloudflare account.
	"ratelimits": [{ "name": "PUBLIC_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
	// Daily at 03:17 UTC: delete records older than 5 years and run the tracking check for each website.
	"triggers": { "crons": ["17 3 * * *"] },
	"observability": { "enabled": true }
}
