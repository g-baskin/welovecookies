# Copy to admin/.env for the self-hosted admin (docs/ADMIN-SELF-HOSTED.md). Never commit the real file.

# Docker Compose: the domain Caddy serves the admin on (DNS must point at this server).
WLC_DOMAIN=consent.example.com

# Without Docker: the address people use for the admin, origin only (Compose sets this from WLC_DOMAIN).
WLC_PUBLIC_URL=http://localhost:8787

# At least 12 characters.
ADMIN_PASSWORD=
# At least 32 random characters: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Behind your own reverse proxy (not needed with Compose, which sets it): use its X-Forwarded-For.
# WLC_TRUST_PROXY=1

# Visitor location headers set by a proxy or CDN you control. Without them every visitor gets the
# strictest (opt-in) banner rules. Examples: cf-ipcountry / cf-region-code,
# x-vercel-ip-country / x-vercel-ip-country-region, cloudfront-viewer-country / cloudfront-viewer-country-region.
# WLC_COUNTRY_HEADER=cf-ipcountry
# WLC_REGION_HEADER=cf-region-code

# Without Docker only (Compose sets these):
# WLC_DB_PATH=admin/data/welovecookies.db
# WLC_HOST=127.0.0.1
# PORT=8787
